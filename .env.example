# .env.example

COMPOSE_PROJECT_NAME=diasekovaltchuk-adv
APP_SECRETS_SOURCE=/root/secrets/diasekovaltchuk-adv/app_secrets.json

# -------------------------------
# Flask
# -------------------------------
FLASK_DEBUG=

# -------------------------------
# Email (exemplo com Gmail)
# -------------------------------
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=

# -------------------------------
# Contato
# -------------------------------
CONTACT_EMAIL=
WHATS_NUMBER=

SOCIAL_FB_URL=
SOCIAL_IG_URL=

# Pode ter vários separados por vírgula
CONTACT_TO=
EMAIL_DNS_VALIDATION_ENABLED=true

# -------------------------------
# CAPTCHA
# -------------------------------
CAPTCHA_ENABLED=

# Ordem de fallback carregada pelo frontend e validada pelo backend.
# Valores suportados: turnstile, recaptcha, hcaptcha
CAPTCHA_PROVIDERS=turnstile
CAPTCHA_TIMEOUT_SECONDS=5

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=

# Google reCAPTCHA v2 checkbox
RECAPTCHA_SITE_KEY=

# hCaptcha
HCAPTCHA_SITE_KEY=
