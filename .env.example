# .env.example


# -------------------------------
# Compose
# -------------------------------
COMPOSE_PROJECT_NAME=diasekovaltchuk-adv-dev
SECRETS_DIR=/srv/vps/envs/projects/diasekovaltchuk-adv/dev/secrets

# -------------------------------
# Laravel
# -------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3003

# -------------------------------
# Email (exemplo com Gmail)
# -------------------------------
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=

# -------------------------------
# Contato
# -------------------------------
CONTACT_EMAIL=
WHATS_NUMBER=

SOCIAL_FB_URL=
SOCIAL_IG_URL=

# Pode ter vários separados por vírgula
CONTACT_TO=
EMAIL_DNS_VALIDATION_ENABLED=true

# -------------------------------
# CAPTCHA
# -------------------------------
CAPTCHA_ENABLED=

# Ordem de fallback carregada pelo frontend e validada pelo backend.
# Valores suportados: turnstile, recaptcha, hcaptcha
CAPTCHA_PROVIDERS=turnstile
CAPTCHA_TIMEOUT_SECONDS=5

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=

# Google reCAPTCHA v2 checkbox
RECAPTCHA_SITE_KEY=

# hCaptcha
HCAPTCHA_SITE_KEY=

# Segredos ficam em SECRETS_DIR, um valor por arquivo:
# app_key, mail_password, turnstile_secret_key,
# recaptcha_secret_key e hcaptcha_secret_key.
