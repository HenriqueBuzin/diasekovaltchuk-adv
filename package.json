{
  "name": "diasekovaltchuk-adv",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "format:frontend": "prettier --write \"frontend/**/*.{ts,tsx,css,html}\" \"*.{js,ts,json}\" \"tests/e2e/**/*.js\"",
    "format:frontend:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html}\" \"*.{js,ts,json}\" \"tests/e2e/**/*.js\"",
    "format:frontend:files": "prettier --write",
    "lint:frontend": "eslint .",
    "lint:frontend:files": "eslint",
    "typecheck:frontend": "tsc --noEmit",
    "test:frontend": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "format:backend": "composer --working-dir=backend format",
    "format:backend:check": "composer --working-dir=backend format:check",
    "lint:backend": "composer --working-dir=backend analyse",
    "test:backend": "php backend/artisan test",
    "prepare": "husky",
    "test": "php scripts/run_tests.php"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.18.1",
    "npm": "12.0.2"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
